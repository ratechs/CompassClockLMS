{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug React Frontend",
            "url": "http://localhost:3000",  // ← React dev server port
            "webRoot": "${workspaceFolder}/src",  // ← Point to source files
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${webRoot}/*",
                "webpack:///src/*": "${webRoot}/*",
                "webpack:///*": "*"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Express Server",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/backend/server.js",
            "env": {
                "NODE_ENV": "development",
                "PORT": "5000"
            },
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": ["Debug React Frontend", "Debug Express Server"]
        }
    ]
}