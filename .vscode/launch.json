{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug React Frontend",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/lms-react-app/src",
            "sourceMapPathOverrides": {
                "webpack:///./src/*": "${workspaceFolder}/lms-react-app/src/*",
                "webpack:///src/*": "${workspaceFolder}/lms-react-app/src/*",
                "webpack:///*": "*"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Express Server",
            "skipFiles": ["<node_internals>/**"],
            "program": "${workspaceFolder}/LMS-react-backend/backend/server.js",
            "envFile": "${workspaceFolder}/LMS-react-backend/.env",
            "console": "integratedTerminal"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": ["Debug React Frontend", "Debug Express Server"]
        }
    ]
}